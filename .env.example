# Copy to .env.local (already gitignored) and fill in once a RevenueCat
# project exists. Until then, the coin shop correctly reports itself as
# unavailable — see src/purchases/ and the "In-app purchases" section of
# README.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Development only. Entitlements fail closed and react-native-purchases can't
# link in Expo Go, so every premium surface is otherwise unreachable in the
# fast dev loop. Set to 1 to grant premium locally with no RevenueCat project,
# no dev build, and no sandbox purchase.
#
# Never set this in an EAS production profile — EXPO_PUBLIC_* vars are inlined
# at build time, so a release built without it compiles to a literal false.
EXPO_PUBLIC_FORCE_PREMIUM=
