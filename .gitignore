# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
logs/

# Test coverage
coverage/

# Temporary files
*.tmp
*.temp

app-example

# Continuous Native Generation: these are regenerated by `expo prebuild` /
# `eas build` from app.json, expo-target.config.js, and the widget config
# plugins — never hand-edited, so never committed.
/android
/ios

# @bacons/apple-targets generates these from expo-target.config.js's
# `entitlements`/`icon`/`images` options on every prebuild. The package's
# own docs say not to hand-edit generated.entitlements directly — go
# through expo-target.config.js instead — so neither is source of truth.
targets/*/generated.entitlements
targets/*/Assets.xcassets/
